simPatches <- simPatchData2(xRange=c(0, 1000), yRange=c(0, 75), cellsize=c(5, 5), crs="EPSG:32617", nPoints=2500,
patches <- c("Bedrock", "Boulder", "Cobble", "Pebble", "Gravel", "Sand", "Silt"),
patchProbs <- c(0.06, 0.04, 0.1, 0.2, 0, 0.3, 0.3),
classProb <- cbind(c(0.6,  0.01, 0.05, 0.02, 0.22, 0.05, 0.05), #bedrock
c(0.01, 0.48, 0.3,  0.1,  0.09, 0.01, 0.01), #boulder
c(0.1,  0.2,  0.38, 0.2,  0.1,  0.01, 0.01), #cobble
c(0.05, 0.05, 0.2,  0.35, 0.2,  0.1,  0.05), #pebble
c(0.15, 0.05, 0.1,  0.2,  0.25, 0.2,  0.05), #gravel
c(0.1,  0.05, 0.05, 0.1,  0.25, 0.35, 0.1), #sand
c(0.15, 0.01, 0.01, 0.01, 0.02, 0.3,  0.5) #silt
)
)
simPatchData2 <- function(xRange=c(0, 1000), yRange=c(0, 1000), cellsize = c(20, 20), crs, nPoints, patches, patchProbs, classAccu){
stopifnot(length(patches)==length(patchProbs))
stopifnot(mean(apply(classAccu, 2, sum)==1)==1)
#define study area, create grid of patches and draw ground-truthing points within study area
sfc <- st_sfc(st_polygon(list(rbind(c(xRange[1], yRange[1]),
c(xRange[2], yRange[1]),
c(xRange[2], yRange[2]),
c(xRange[1], yRange[2]),
c(xRange[1], yRange[1])))),
crs=crs)
geometry <- st_make_grid(sfc, cellsize = cellsize, crs=crs)
#convert locations to sf objects
remSensPoly <- st_sf(geometry, remSensID=seq_along(geometry), gridArea=prod(cellsize))
patches <- factor(patches, levels=patches)
#draw true patch types
remSensPoly$gtPatchID <- apply(rmultinom(n=nrow(remSensPoly), size=1, prob=patchProbs), 2, which.max)
remSensPoly$gtPatchType <- patches[remSensPoly$gtPatchID]
#draw patch classifications
remSensPoly$remSensPatchID <- NA
for(i in 1:nrow(remSensPoly)){
remSensPoly$remSensPatchID[i] <- which.max(rmultinom(n=1, size=1, prob=classProb[, remSensPoly$gtPatchID[i]]))
}
remSensPoly$remSensPatchType <- patches[remSensPoly$remSensPatchID]
#pull ground-truthing data
# gtPoints <- st_sample(sfc, nPoints, by_polygon = TRUE)
# gtPoints <- st_sf(gtPoints, gtID=seq_along(gtPoints))
gtSamp <- sample(1:nrow(remSensPoly), nPoints)
gtPoints <- remSensPoly[gtSamp, c("remSensID", "gtPatchID", "gtPatchType")]
gtPoints$gtID <- 1:nPoints
#subset remSensPoly to just co-located ground-truthing and classified polygons
gtRemSensJoin <- remSensPoly[gtSamp,]
gtRemSensJoin$gtID <- 1:nPoints
# #conduct a spatial join to merge the ground-truthing and remote sensing data
# gtRemSensJoin <- st_join(gtPoints, remSensPoly, st_within, left=TRUE)
return(list(remSensPoly=remSensPoly,
gtPoints=gtPoints,
gtRemSensJoin=gtRemSensJoin))
}
set.seed(385)
simPatches <- simPatchData2(xRange=c(0, 1000), yRange=c(0, 75), cellsize=c(5, 5), crs="EPSG:32617", nPoints=2500,
patches <- c("Bedrock", "Boulder", "Cobble", "Pebble", "Gravel", "Sand", "Silt"),
patchProbs <- c(0.06, 0.04, 0.1, 0.2, 0, 0.3, 0.3),
classProb <- cbind(c(0.6,  0.01, 0.05, 0.02, 0.22, 0.05, 0.05), #bedrock
c(0.01, 0.48, 0.3,  0.1,  0.09, 0.01, 0.01), #boulder
c(0.1,  0.2,  0.38, 0.2,  0.1,  0.01, 0.01), #cobble
c(0.05, 0.05, 0.2,  0.35, 0.2,  0.1,  0.05), #pebble
c(0.15, 0.05, 0.1,  0.2,  0.25, 0.2,  0.05), #gravel
c(0.1,  0.05, 0.05, 0.1,  0.25, 0.35, 0.1), #sand
c(0.15, 0.01, 0.01, 0.01, 0.02, 0.3,  0.5) #silt
)
)
ggplot()+
geom_sf(data=simPatches$remSensPoly, aes(fill=remSensPatchType), color="grey") +
scale_fill_viridis_d() +
labs(fill="Classified\nPatch Type") +
coord_sf(datum = st_crs("EPSG:32617"))
templete <- rast(vect(simPatches$remSensPoly), resolution=c(1,1))
areaRaster <- rasterize(x=simPatches$remSensPoly, y=templete, field="remSensPatchID")
depRast <- simulate_data(areaRaster, intensity=3, sd=2, n=1, scale=0.2, transform=abs)
velRast <- simulate_data(areaRaster, intensity=0.5, n=1, scale=0.2, transform=abs)
#change field names to something more meaningful
names(depRast) <- "dep"
names(velRast) <- "vel"
plot(depRast, plg=list(at=c(0, 4, 8, 12)))
plot(velRast, plg=list(at=c(0, 2, 4, 6)))
simPatches$gtRemSensJoin
simPatches
