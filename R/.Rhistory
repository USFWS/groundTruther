speedOfSound <- function(waterT, S, Z, phi){
1402.5 + 5*waterT - 5.44 * (10^-2)*(waterT^2) + 2.1 *
(10^-4)*(waterT^3) +
1.33*S - 1.23 * (10^-2)*S*waterT + 8.7 * (10^-5)*S*(waterT^2) +
1.56 * (10^-2)*Z + 2.55 * (10^-7)*(Z^2) - 7.3 * (10^-12)*(Z^3)+
1.2 * (10^-6)*Z*(phi - 45) - 9.5 * (10^-13)*waterT*(Z^3) +
3 * (10^-7)*(waterT^2)*Z + 1.43 * (10^-5)*S*Z
}
